# Commit 信息检查
# pre-push 钩子脚本在执行时，Git 会自动将远程仓库的名称作为第一个参数（$1）传入
remote_name="$1"
if [ -z "$remote_name" ]; then
 echo "❌ 没有获取到远程仓库名"
 exit 1
fi
# 获取远程最新的 master 指针
git fetch "$remote_name" master
# --from remote_name/master: 检查当前分支相比于远程 master 分支新增的 commit 的信息
pnpm exec commitlint --from "${remote_name}/master" --verbose

# 安全检查 (使用官方源以避免报错)
echo "🛡️ 正在执行依赖包的安全性检查..."
pnpm audit --audit-level high --registry=https://registry.npmjs.org

# 检查上一步的退出码，如果失败直接退出，成功则跑下面的
if [ $? -ne 0 ]; then
 echo "❌ 检查到依赖出现高危安全漏洞!"
 exit 1
fi

# TypeScript 类型检查
echo "正在执行 TypeScript 类型检查..."
pnpm run type:check

# 同样检查退出码
if [ $? -ne 0 ]; then
 echo "❌ 检查到 TypeScript 类型错误"
 exit 1
fi

echo "✅ 通过所有检查，正在推送到远程仓库 ${remote_name}..."
